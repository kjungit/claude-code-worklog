{
  "description": "Automatic worklog capture and summarization",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/on_stop.py",
            "args": []
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/check_and_summarize.py",
            "args": [],
            "async": true
          }
        ]
      }
    ]
  }
}
